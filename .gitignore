# ============================================================================
#  上传前的忽略规则
#
#  ⚠️ 绝对不能提交的东西在下面「密钥」一节 —— 提交了就等于把 App 的签名权
#     交给所有人，别人可以签出冒充你的安装包。
# ============================================================================

# --- 密钥（最重要）--------------------------------------------------------
*.jks
*.keystore
keystore.properties
local.properties

# --- 参考产物：模型权重、tokenizer 等大文件，需要时用脚本重新下载 -----------
#  reference/en/tokenizer.json        3.4 MB
#  reference/models/model_int4.onnx   262 MB
#  reference/candidates/*.onnx        414 MB+
reference/

# --- 构建产物 -------------------------------------------------------------
build/
.gradle/
*.apk
*.aab
*.ap_
captures/

# --- Node -----------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# --- 测试与工具输出 -------------------------------------------------------
app/app/build/kotlin-sequence-dump.json
*.hprof

# --- IDE / 系统 -----------------------------------------------------------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# --- 日志 -----------------------------------------------------------------
*.log

